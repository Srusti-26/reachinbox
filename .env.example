# ─── Application ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=change_this_to_a_long_random_string_in_production

# ─── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ─── PostgreSQL (Prisma) ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://reachinbox:reachinbox_secret@localhost:5432/reachinbox_db?schema=public"

# ─── Redis (BullMQ) ───────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Rate Limiting ────────────────────────────────────────────────────────────
MAX_EMAILS_PER_HOUR=1000

# ─── Slack Webhook ────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#email-alerts

# ─── Real-World SMTP (Optional) ───────────────────────────────────────────────
# Leave blank to use Ethereal Email sandbox (auto-created on startup).
# For Gmail: generate a 16-char App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
