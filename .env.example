# ─── Application ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=change_me_to_a_long_random_string
# Shows a "skip OAuth" button on the login screen. Local development only; ignored when NODE_ENV=production.
ALLOW_DEV_LOGIN=false

# ─── Google OAuth 2.0 ────────────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials  (Web application)
# Authorized redirect URI: http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ─── PostgreSQL (Prisma) ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://reachinbox:reachinbox_secret@localhost:5432/reachinbox_db?schema=public"

# ─── Redis (BullMQ + rate-limit counters) ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Elasticsearch (email search; app falls back to SQL search if it's down) ──
ELASTICSEARCH_URL=http://localhost:9200

# ─── Throughput controls (nothing hardcoded in the worker) ───────────────────
# Parallel jobs per worker process
WORKER_CONCURRENCY=5
# Minimum gap between ANY two sends, shared across all workers (BullMQ limiter: 1 job / N ms)
MIN_DELAY_BETWEEN_SENDS_MS=2000
# Hard ceiling of emails per hour for EACH sender mailbox (campaign / mailbox limits can only go lower)
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# ─── Slack OAuth (api.slack.com/apps -> OAuth & Permissions) ─────────────────
# Scope: incoming-webhook.  Redirect URL must match exactly. Slack may require HTTPS:
# if http://localhost is rejected, expose the app via an https tunnel and set APP_URL + SLACK_REDIRECT_URI to it.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/api/v1/slack/oauth/callback

# ─── Optional real SMTP fallback (leave blank: senders are Ethereal accounts created automatically) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
